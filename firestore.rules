rules_version = '2';

// Ledgerline security rules.
// Each person's data lives under /users/{their uid}/ and only that signed-in person can read or write it.
// Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    // Access: the first 5 Google accounts to sign in get a seat; the 6th and later are blocked.
    // A seat is claimed by creating /seats/{1..5} and /members/{uid} together in one batch.
    // Creating a seat that is already taken counts as an update, which is denied, so two
    // people can never get the same seat. To free a seat, delete both documents in the
    // Firebase console (Firestore → members/{uid} and seats/{n}).
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    // The owner keeps access even if all seats are taken.
    function isAdmin() {
      return request.auth.token.email in ['janardhan579.n@gmail.com'];
    }
    function isMember() {
      return exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }
    function isAllowed() {
      return signedIn() && (isAdmin() || isMember());
    }

    function isOwner(uid) {
      return isAllowed() && request.auth.uid == uid;
    }

    // settings, plan (budgets, goals, recurring, debts, assumptions) and cached market rates
    match /users/{uid}/ledger/{docId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && docId in ['settings', 'plan', 'market']
        && request.resource.data.keys().size() < 30;
    }

    // one document per month: { month: 'YYYY-MM', items: [ ...transactions ] }
    match /users/{uid}/months/{month} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && request.resource.data.keys().hasOnly(['month', 'items'])
        && request.resource.data.month == month
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 3000;
    }

    // small copies of scanned receipts and payslips (base64 image or PDF, under ~700 KB)
    match /users/{uid}/receipts/{receiptId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['id', 'name', 'mime', 'data', 'size', 'createdAt'])
        && request.resource.data.id == receiptId
        && request.resource.data.mime in ['image/jpeg', 'application/pdf']
        && request.resource.data.data is string
        && request.resource.data.data.size() < 700000;
    }

    // One document per person with a seat. Readable only by that person; never changed by the app.
    match /members/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['seat', 'email', 'joinedAt'])
        && request.resource.data.seat in ['1', '2', '3', '4', '5']
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.joinedAt is string
        && getAfter(/databases/$(database)/documents/seats/$(request.resource.data.seat)).data.uid == uid;
    }

    // Exactly five seats. Create-only, so a taken seat can't be overwritten.
    match /seats/{seat} {
      allow create: if signedIn()
        && seat in ['1', '2', '3', '4', '5']
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.seat == seat;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
